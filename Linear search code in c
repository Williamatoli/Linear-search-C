
#include <stdio.h>

int main() {
    int arr[5], i, search, found = 0;

    // Enter array elements
    for(i = 0; i < 5; i++) {
        printf("Enter number: ");
        scanf("%d", &arr[i]);
    }

    // Enter number to search
    printf("Enter number to search: ");
    scanf("%d", &search);

    // Linear search
    for(i = 0; i < 5; i++) {
        if(arr[i] == search) {
            found = 1;
            break;
        }
    }

    if(found == 1) {
        printf("Number found at position %d", i + 1);
    } else {
        printf("Number not found");
    }

    return 0;
}
